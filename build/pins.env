# Every upstream input of the engine build, pinned. Change a pin here and nowhere else.
# Sourced by build/build.sh (host) and passed into the image as build args.

# Base image (Ubuntu 24.04 LTS). The digest is recorded in build/out/<id>/build-info.json after each build.
BASE_IMAGE=ubuntu:24.04

# Emscripten: emsdk at the 3.1.65 release, then allotropia's four commits on top of it
# (branch fixed-3.1.65, 949ee1d4), applied as build/patches/emscripten/0001-allotropia-fixed-3.1.65.patch.
EMSDK_REPO=https://github.com/emscripten-core/emsdk.git
EMSDK_REF=3.1.65
EMSCRIPTEN_VERSION=3.1.65

# Qt 5.15.2 for WebAssembly: allotropia's qtbase, branch 5.15.2+wasm.
QTBASE_REPO=https://github.com/allotropia/qtbase.git
QTBASE_COMMIT=a320678c85ec8029d5394bcd673d4c208af1de3a

# LibreOffice core: branch distro/allotropia/zeta-24-2 (the ZetaOffice 24.2 line).
CORE_REPO=https://github.com/LibreOffice/core.git
CORE_COMMIT=dced3bc711d18407a2cc2400eb46e8261b663d95
