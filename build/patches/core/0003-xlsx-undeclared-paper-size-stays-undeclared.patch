+/** Remembers, in the document's InteropGrabBag, that the file declared no paper size for this page
+    style, and the size the style got instead, so that the export writes none either. */
+void lclRememberUndeclaredPaperSize( ScDocument& rDoc, const rtl::Reference< ScModelObj >& rxDocument,
+                                     const OUString& rStyleName )
+{
+    SfxStyleSheetBase* pStyle = rDoc.GetStyleSheetPool()->Find( rStyleName, SfxStyleFamily::Page );
+    if( !pStyle || !rxDocument.is() )
+        return;
+    const Size aSize = pStyle->GetItemSet().Get( ATTR_PAGE_SIZE ).GetSize();
+
+    SolarMutexGuard aGuard;
+    comphelper::SequenceAsHashMap aGrabBag( rxDocument->getPropertyValue( u"InteropGrabBag"_ustr ) );
+    Sequence< beans::PropertyValue > aStyles;
+    aGrabBag[ EXC_GRABBAG_UNDECLARED_PAPER ] >>= aStyles;
+    sal_Int32 nCount = aStyles.getLength();
+    aStyles.realloc( nCount + 1 );
+    aStyles.getArray()[ nCount ] = comphelper::makePropertyValue(
+        rStyleName, awt::Size( aSize.Width(), aSize.Height() ) );
+    aGrabBag[ EXC_GRABBAG_UNDECLARED_PAPER ] <<= aStyles;
+    rxDocument->setPropertyValue( u"InteropGrabBag"_ustr, Any( aGrabBag.getAsConstPropertyValueList() ) );
+}
+
 } // namespace
 
