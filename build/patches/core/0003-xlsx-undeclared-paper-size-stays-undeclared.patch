+/** True, if the imported OOXML file declared no paper size for this page style and the style still
+    has the size it was given then (in either orientation): the user has not chosen a paper since. */
+bool lclIsPaperSizeUndeclared( ScModelObj* pModel, const OUString& rStyleName, const Size& rSize )
+{
+    if( !pModel )
+        return false;
+    const comphelper::SequenceAsHashMap aGrabBag( pModel->getPropertyValue( u"InteropGrabBag"_ustr ) );
+    const auto aStyles = aGrabBag.getUnpackedValueOrDefault(
+        EXC_GRABBAG_UNDECLARED_PAPER, css::uno::Sequence< css::beans::PropertyValue >() );
+    for( const css::beans::PropertyValue& rStyle : aStyles )
+    {
+        css::awt::Size aSize;
+        if( rStyle.Name == rStyleName && ( rStyle.Value >>= aSize ) )
+            return ( aSize.Width == rSize.Width() && aSize.Height == rSize.Height() ) ||
+                   ( aSize.Width == rSize.Height() && aSize.Height == rSize.Width() );
+    }
+    return false;
+}
+
